---
import live from "../data/live.json" with { type: "json" };
import friends from "../data/friends.json" with { type: "json" };
import notes from "../data/notes.json" with { type: "json" };
import projects from "../data/projects.json" with { type: "json" };
import works from "../data/works.json" with { type: "json" };

import "../styles/css3d.css";
---

<svg
    class="triangle-grid"
    width="100%"
    height="100%"
    xmlns="http://www.w3.org/2000/svg"
>
    <defs>
        <pattern
            id="trianglePattern"
            width="80"
            height="69.28"
            patternUnits="userSpaceOnUse">
            
            <path
                d="M0 0 L40 69.28 L80 0 Z"
                fill="none"
                stroke="currentColor"
                stroke-width="1"></path>

            <path
                d="M0 69.28 L40 0 L80 69.28 Z"
                fill="none"
                stroke="currentColor"
                stroke-width="1"></path>
        </pattern>
    </defs>

    <rect width="100%" height="100%" fill="url(#trianglePattern)"></rect>
</svg>

<div class="relative mt-14 h-[80%] w-full">
    <div class="page-title">
        01
        <h3 class="text-lg">Home Page</h3>
    </div>

    <div class="h-full w-full float-in">
        <div id="logo2d" class="absolute top-[48%] w-full scale-90 -translate-y-[50%]"></div>
    </div>

    <div class="last-update-container float-in">
        Last Update
        <h3 class="last-update-date float-in">May 2026</h3>
    </div>

    <div class="social-link-container float-in">
        <a class="social-link" href="https://discord.gg/GWEmUwaSFG" target="_blank">
            <span class="fa-brands fa-discord"></span>
            <span class="">Discord</span>
        </a>

        <a class="social-link" href="https://github.com/lbc0841" target="_blank">
            <span class="fa-brands fa-github"></span>
            <span class="">GitHub</span>
        </a>
     </div>
</div>

<div class="relative mt-24 h-[90%] w-full">
    <div class="page-title">
        02
        <h3 class="text-lg">About Me</h3>
    </div>

    <div class="absolute w-[26%] top-[26%] left-0 float-in">
        <!-- <img class="avatar mt-auto" src="https://avatars.githubusercontent.com/lbc0841" alt="avatar"/> -->
        <div class="motto my-6">梭哈，是種智慧<br />賭狗，應有盡有</div>
        <h3 class="author-desc">- MBIT：INTP<br />- 愚人節生日<br />- 我裂開了</h3>

        <div class="w-36 h-36 rounded-[50%] border-2 border-zinc-500 mt-12 ml-4">
            <h3 class="text-4xl my-2 text-center">
                <span class="text-zinc-500 text-sm">APCS</span><br>
                4/3
            </h3>
        </div>
    </div>

    

    <div class="absolute w-[74%] top-20 right-0">

        <div class="group relative border-l border-zinc-600 pl-6 hover:border-l-4 hover:border-white duration-150 float-in">
            <h2 class="text-2xl">&gt; WORKS</h2>
            {
                works.map((w) => (
                    <a class="relative block ml-2 my-2 p-2 opacity-50 hover:opacity-100 duration-100" href={w.url} target="_blank">
                        <h3 class="text-lg/tight">{w.title}<br/>
                            <span class="text-xs text-zinc-500">{w.desc}</span>
                        </h3>

                        <span class="block text-xs text-zinc-500 absolute top-[50%] right-0">{w.date}</span>
                    </a>
                ))
            }
            
            <a class="absolute opacity-0 group-hover:opacity-100 top-2 right-0 text-sm text-zinc-500 hover:text-white duration-150"
                href="https://lbc0841.github.io/works">
                View More
            </a>          
        </div>

        <div class="group relative mt-14 border-l border-zinc-600 pl-6 hover:border-l-4 hover:border-white duration-150 float-in">
            <h2 class="text-2xl">&gt; NOTES</h2>
            {
                notes.map((n) => (
                    <a class="relative block ml-2 my-2 p-2 opacity-50 hover:opacity-100 duration-100" href={n.url} target="_blank">
                        <h3 class="text-lg/tight">{n.title}<br/>
                            <span class="text-xs text-zinc-500">{n.desc}</span>
                        </h3>

                        <span class="block text-xs text-zinc-500 absolute top-[50%] right-0">{n.date}</span>
                    </a>
                ))
            }
            <a class="absolute opacity-0 group-hover:opacity-100 top-2 right-0 text-sm text-zinc-500 hover:text-white duration-150"
                href="https://lbc0841.github.io/notes">
                View More
            </a> 
        </div>
        

        <div class="group relative mt-14 border-l border-zinc-600 pl-6 hover:border-l-4 hover:border-white duration-150 float-in">
            <h3 class="text-2xl">&gt; PROJECTS</h3>
            {
                projects.map((p) => (
                    <a class="relative block ml-2 my-2 p-2 opacity-50 hover:opacity-100 duration-100" href={p.url} target="_blank">
                        <h3 class="text-lg/tight">{p.title}<br/>
                            <span class="text-xs text-zinc-500">{p.desc}</span>
                        </h3>

                        <span class="block text-xs text-zinc-500 absolute top-[50%] right-0">{p.date}</span>
                    </a>
                ))
            }
            <a class="absolute opacity-0 group-hover:opacity-100 top-2 right-0 text-sm text-zinc-500 hover:text-white duration-150"
                href="https://lbc0841.github.io/projects">
                View More
            </a> 
        </div>
    </div>
</div>

<div class="relative mt-24 h-[80%] w-full">
    <div class="page-title">
        03
        <h3 class="text-lg">My Live</h3>
    </div>

    <div class="live-container">
        {
            live.map((l) => (
                <div class="live-item float-in">
                    <div
                        class="live-img"
                        style={`background: url("${l.image}"); background-size: cover; background-position: center;`}
                    />
                    <div class="live-content">{l.name}</div>
                </div>
            ))
        }
    </div>
</div>

<div class="relative mt-24 h-[80%] w-full">
    <div class="page-title">
        04
        <h3 class="text-lg">My Friends</h3>
    </div>

    <div class="friends-container">
        {
            friends.map((f) => (
                <a class="friend float-in" href={f.url} target="_blank">
                    <img class="h-full" src={f.avatar} alt={f.name} />
                    <div class="w-full hidden sm:block">
                        <h3 class="name">{f.name}</h3>
                        <span class="friend-desc">{f.desc}</span>
                    </div>
                </a>
            ))
        }
    </div>
</div>

<div class="relative mt-16 w-full">
    <h3 class="absolute bottom-2 left-2 text-sm text-zinc-500">
        Powered by Astro
    </h3>
    <h3 class="absolute bottom-2 right-2 text-sm text-zinc-500">
        Copyright © 2026 lbc
    </h3>
</div>

<script>
    window.addEventListener("load", function () {
        lottie.loadAnimation({
            container: logo2d,
            renderer: "svg",
            loop: false,
            autoplay: true,
            path: "/lottie/logo.json",
        });
    });
</script>