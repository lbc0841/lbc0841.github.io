---
import "../styles/global.css";
import "../styles/border.css";

const themeColor = "#0b171d"; 
const favicon = "/icrack41-blog/favicon.svg";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />

		<meta name="theme-color" content={themeColor}>

		<!-- favicon -->
		<link rel="canonical" href="https://lbc0841.github.io/">
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />

		<!-- font: Share+Tech+Mono -->
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&family=Share+Tech+Mono&display=swap">

		<!-- KaTeX -->
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">

		<!-- font-awesome -->
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" 
			integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" 
			crossorigin="anonymous" referrerpolicy="no-referrer" />

		<!-- lottie -->
		<script src="https://cdnjs.cloudflare.com/ajax/libs/lottie-web/5.12.2/lottie.min.js" defer></script>

		<meta name="generator" content={Astro.generator} />
		<title>ICRACK</title>
		<meta name="description" content="程式．生活．學習，Astro × GitHub Pages 搭建的個人部落格">
	</head>

	<body>
		<slot />
	</body>

	<script src="../scripts/scrollAnim.js"/>
</html>
