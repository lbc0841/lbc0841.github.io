---
import Layout from '../layouts/Layout.astro';

import Loader from '../components/Loader.astro';

import Page2D from '../components/page2d.astro';
import Page3D from '../components/page3d.astro';

import '../styles/css3d.css'
---

<Layout>
	<!-- MainNavigation -->
	<div class="absolute top-0 left-0 w-full px-4 md:px-10 flex justify-between align-middle z-999">
        <button class="font-bold my-4" onclick="location.href='/';">ICRACK</button>

        <!-- MenuBar -->
        <div class="flex gap-6">
            <button id="home-button" class="my-4 text-white/60 hover:text-white filter hover:drop-shadow-[0_0_6px_white] duration-200 hidden sm:block">HOME</button>
            <button id="about-button" class="my-4 text-white/60 hover:text-white filter hover:drop-shadow-[0_0_6px_white] duration-200">ABOUT</button>
            <button id="notes-button" class="my-4 text-white/60 hover:text-white filter hover:drop-shadow-[0_0_6px_white] duration-200">LIVE</button>
            <button id="friends-button" class="my-4 text-white/60 hover:text-white filter hover:drop-shadow-[0_0_6px_white] duration-200">FRIENDS</button>

            <input id="switch-2d-3d" type="checkbox" class="h-0 w-0 hidden"/>
            <label id="label-for-switch-2d-3d" for="switch-2d-3d" class="relative flex gap-4 bg-zinc-600/35 rounded-sm my-4 px-2 py-1">
                <span class="">2D</span>
                <span class="">3D</span>
            </label>
        </div>
	</div>

	<!-- <Scanlines/> -->
	<Loader/>

    <div id="page2d" class="w-full h-full px-6 overflow-y-scroll overflow-x-hidden" style="display: block;">
        <Page2D/>
    </div>

    <div id="page3d" class="w-full h-full" style="display: none;">
        <Page3D/>
    </div>
    
</Layout>

<script src="../scripts/main.js"/>


<script>
    const switch2D3D = document.getElementById('switch-2d-3d');
    const page2d = document.getElementById('page2d');
    const page3d = document.getElementById('page3d');

    switch2D3D?.addEventListener('change', () => {
        if (switch2D3D.checked) {
            page2d?.setAttribute('style', 'display: none;');
            page3d?.setAttribute('style', 'display: block;');
        } else {
            page2d?.setAttribute('style', 'display: block;');
            page3d?.setAttribute('style', 'display: none;');
        }
    });

const homeButton = document.getElementById("home-button");
const aboutButton = document.getElementById("about-button");
const notesButton = document.getElementById("notes-button");
const friendsButton = document.getElementById("friends-button");

homeButton?.addEventListener("click", () => {
    page2d?.scrollTo({ top: 0, behavior: "smooth" });
});

aboutButton?.addEventListener("click", () => {
    page2d?.scrollTo({ top: window.innerHeight*0.8 + 96 + 14, behavior: "smooth" });
});

notesButton?.addEventListener("click", () => {
    page2d?.scrollTo({ top: window.innerHeight*0.8*2 + 96*2 + 14*2, behavior: "smooth" });
});

friendsButton?.addEventListener("click", () => {
    page2d?.scrollTo({ top: window.innerHeight*0.8*3 + 96*3 + 14*3, behavior: "smooth" });
});
</script>
